# CircuIT (Azure OpenAI gateway). Never commit real values.
CIRCUIT_LLM_CLIENT_ID=
CIRCUIT_LLM_CLIENT_SECRET=
CIRCUIT_LLM_APP_KEY=
CIRCUIT_LLM_TOKEN_URL=
CIRCUIT_LLM_CHAT_URL=
CIRCUIT_LLM_DEPLOYMENT=

# PAT of the generic techdebt-bot Jira user (the same user as jira-cli --instance techdebt-bot), used for attachments and
# permissions. Never a personal token: preflight blocks the Scan unless this resolves to techdebt-bot.
DEBTDOCTOR_JIRA_BASE_URL=
DEBTDOCTOR_JIRA_TOKEN=
# Jira Cloud (*.atlassian.net): the email that owns the API token. Leave unset for Server/DC tokens.
DEBTDOCTOR_JIRA_EMAIL=
# Developer override: your Jira username (Cloud: the part of your email before @) may write instead of techdebt-bot. Leave unset in real use.
DEBTDOCTOR_JIRA_ALLOW_USER=
