# CircuIT (Azure OpenAI gateway). Never commit real values.
CIRCUIT_LLM_CLIENT_ID=
CIRCUIT_LLM_CLIENT_SECRET=
CIRCUIT_LLM_APP_KEY=
CIRCUIT_LLM_TOKEN_URL=
CIRCUIT_LLM_CHAT_URL=
CIRCUIT_LLM_DEPLOYMENT=

# Jira credentials for every Jira call: DebtDoctor passes them to jira-cli itself, so jira-cli needs no `config`.
# Normally the generic techdebt-bot user's token; preflight blocks the Scan unless it resolves to techdebt-bot (or DEBTDOCTOR_JIRA_ALLOW_USER).
DEBTDOCTOR_JIRA_BASE_URL=
DEBTDOCTOR_JIRA_TOKEN=
# Jira Cloud (*.atlassian.net): the email that owns the API token. Leave unset for Server/DC tokens.
DEBTDOCTOR_JIRA_EMAIL=
# Developer override: your Jira username (Cloud: the part of your email before @) may write instead of techdebt-bot. Leave unset in real use.
DEBTDOCTOR_JIRA_ALLOW_USER=
# One Jira project for every repo, e.g. TECHDEBT: each repo gets its own <repo>-tech-debts Epic and td-repo-<repo> label there.
# Overrides the project key in every Repo Profile, and repos without a profile scan with the defaults (no dd setup needed).
DEBTDOCTOR_JIRA_PROJECT=
# Extra labels on every Epic and ticket, comma-separated, e.g. the label your board's filter selects on (ai-generated).
DEBTDOCTOR_JIRA_EXTRA_LABELS=
